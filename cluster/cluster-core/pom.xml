<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.dozendb</groupId>
    <artifactId>cluster-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cluster-core</artifactId>
  <name>DozenDB Neo4j integration</name>
  <description>Bootstrap, settings, cluster formation and procedures. Neo4j internals are used only under internal/.</description>

  <dependencies>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>cluster-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-ratis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
    </dependency>

    <!-- On the Neo4j classpath at runtime. -->
    <dependency>
      <groupId>org.neo4j</groupId>
      <artifactId>neo4j</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>cluster-api</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility-kotlin</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>org/dozendb/cluster/core/dozendb.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>org/dozendb/cluster/core/dozendb.properties</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
