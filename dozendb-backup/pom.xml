<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.dozendb</groupId>
    <artifactId>dozendb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>dozendb-backup</artifactId>
  <name>DozenDB backup</name>
  <description>Online backup and restore of a database, on any server, clustered or not.</description>
  <dependencies>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-api</artifactId>
    </dependency>
    <!-- For its bulk transfers, which backups use on an address of their own. -->
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-ratis</artifactId>
    </dependency>

    <!-- On the Neo4j classpath at runtime. -->
    <dependency>
      <groupId>org.neo4j</groupId>
      <artifactId>neo4j</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-api</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- The cloud in memory, through the cloud providers, without the clouds' SDKs. -->
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-cloud</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-cloud</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- TestCertificates in the consensus-api test-jar uses it. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
