<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.dozendb</groupId>
    <artifactId>dozendb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>dozendb-cluster</artifactId>
  <name>DozenDB clustering</name>
  <description>Raft replication of every database on top of dozendb-core: cluster formation and membership, catch-up, routing and reads, single fsync, and the cluster procedures. Neo4j internals are used only under internal/.</description>

  <dependencies>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-ratis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
    </dependency>

    <!-- On the Neo4j classpath at runtime. -->
    <dependency>
      <groupId>org.neo4j</groupId>
      <artifactId>neo4j</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-api</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility-kotlin</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestCertificates in the consensus-api test-jar uses it. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- With its own Netty shaded: Neo4j's Netty is on the same classpath. -->
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver-all</artifactId>
      <version>${neo4j-java-driver.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
