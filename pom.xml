    <module>consensus-api</module>
    <module>consensus-ratis</module>
    <module>dodeca-core</module>
    <module>dodeca-cloud</module>
    <module>dodeca-backup</module>
    <module>dodeca-cluster</module>
    <module>dodeca-plugin</module>
    <module>dodeca-it</module>
