  <!-- Every module is Kotlin and tested with JUnit and AssertJ. -->
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Kotlin only. A module that needs Java compiles src/main/java with maven-compiler-plugin,
         before Kotlin, as consensus-ratis does. -->
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <!--
              The sources are Kotlin, compiled by kotlin-maven-plugin. The incremental build check
              scans the main classes directory, which modules without main sources do not have.
            -->
            <useIncrementalCompilation>false</useIncrementalCompilation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.jetbrains.kotlin</groupId>
          <artifactId>kotlin-maven-plugin</artifactId>
          <version>${kotlin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <configuration>
          <jvmTarget>${java.release}</jvmTarget>
          <args>
            <arg>-Xjdk-release=${java.release}</arg>
            <arg>-Werror</arg>
          </args>
        </configuration>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals>
              <goal>test-compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
          <forkCount>${test.forks}</forkCount>
          <reuseForks>true</reuseForks>
          <!-- Neo4j's Bolt server releases connection memory it never allocated and, with
               assertions on, logs an AssertionError whenever a connection closes; plain Neo4j
               Community does the same. -->
          <!-- Neo4j's decoders of transaction log commands assert on what they read, and so do the
               property records and blocks they build. After a power loss with holes in the
               unforced log, garbage then fails the database's start with an AssertionError instead
               of ending the readable log, as it does where assertions are off, as in production
               (PowerLossTest). -->
          <!-- The fork number, so that JVMs of one build take ports from different parts of
               TestPorts' range; in systemPropertyVariables, Maven 3.9 leaves it empty. -->
          <!-- The JDK modules that Neo4j's neo4j.conf opens to it (server.jvm.additional), as
               its off-heap memory needs them. -->
          <argLine>-Xmx${test.heap} -Djava.io.tmpdir=${test.tmpdir} -Ddodeca.test.fork=${surefire.forkNumber} --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -da:org.neo4j.bolt.protocol.common.connector.connection.ConnectionMemoryTracker -da:org.neo4j.internal.recordstorage.LogCommandSerializationV4_2 -da:org.neo4j.internal.recordstorage.LogCommandSerializationV5_0 -da:org.neo4j.kernel.impl.store.record.PropertyRecord -da:org.neo4j.kernel.impl.store.record.PropertyBlock</argLine>
          <!-- Fail instead of silently skipping tests JUnit cannot run, e.g. non-Unit Kotlin tests.
               A test or set-up that runs for more than 10 minutes, well above the longest on CI,
               fails with a dump of every thread, instead of holding the build until CI's job times
               out with nothing to show. -->
          <properties>
            <configurationParameters>
              junit.platform.discovery.issue.severity.critical=WARNING
              junit.jupiter.execution.timeout.default=10m
              junit.jupiter.execution.timeout.threaddump.enabled=true
            </configurationParameters>
          </properties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <!-- Here rather than in pluginManagement: GitHub's dependency graph otherwise reads ktfmt's
             version below as the plugin's and raises the plugin's old advisories. -->
        <version>${spotless.version}</version>
        <configuration>
          <kotlin>
            <includes>
              <include>src/**/*.kt</include>
            </includes>
            <ktfmt>
              <version>${ktfmt.version}</version>
              <style>KOTLINLANG</style>
            </ktfmt>
          </kotlin>
          <java>
            <includes>
              <include>src/**/*.java</include>
            </includes>
            <palantirJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Test data on the RAM disk that scripts/test-ramdisk.sh creates, while it is mounted:
           Neo4j and Raft force every commit to disk, which on an SSD takes most of a test's
           time, and more so for tests that run at once. -->
      <id>test-ramdisk</id>
      <activation>
        <file>
          <exists>/Volumes/DodecaTests</exists>
        </file>
      </activation>
      <properties>
        <test.tmpdir>/Volumes/DodecaTests</test.tmpdir>
      </properties>
    </profile>
  </profiles>
</project>
