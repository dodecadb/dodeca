  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.release>21</java.release>
    <maven.compiler.release>${java.release}</maven.compiler.release>

    <!-- Pinned platform (see doc/UPSTREAM_TOUCHPOINTS.md). -->
    <neo4j.version>2026.10.2</neo4j.version>
    <!-- Neo4j ships slf4j-api 2.0.17 in lib/. We compile against it and never bundle it. -->
    <slf4j.version>2.0.17</slf4j.version>

    <kotlin.version>2.4.21</kotlin.version>
    <kotlinx-coroutines.version>1.11.0</kotlinx-coroutines.version>
    <ratis.version>3.3.1</ratis.version>
    <dropwizard-metrics.version>4.2.40</dropwizard-metrics.version>
    <!-- The cloud storage SDKs, bundled in the plugin jar, relocated (doc/COMPATIBILITY.md). -->
    <aws-sdk.version>2.58.0</aws-sdk.version>
    <azure-sdk-bom.version>1.3.10</azure-sdk-bom.version>
    <google-cloud-bom.version>26.93.0</google-cloud-bom.version>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <awaitility.version>4.3.0</awaitility.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <neo4j-java-driver.version>6.3.0</neo4j-java-driver.version>
    <archunit.version>1.5.1</archunit.version>
    <bouncycastle.version>1.87</bouncycastle.version>

    <spotless.version>3.11.0</spotless.version>
    <ktfmt.version>0.64</ktfmt.version>

    <!-- The Docker image the plugin is tested against and installed into. -->
    <neo4j.image>neo4j:${neo4j.version}-community</neo4j.image>
    <!-- Emulators of the clouds' storage, for tests of cloud storage. -->
    <s3mock.image>adobe/s3mock:5.2.3</s3mock.image>
    <fake-gcs.image>fsouza/fake-gcs-server:1.56.1</fake-gcs.image>
    <azurite.image>mcr.microsoft.com/azure-storage/azurite:3.37.0</azurite.image>

    <!-- Test classes run in this many JVMs at once, each with this much heap at most. -->
    <test.forks>4</test.forks>
    <test.heap>4g</test.heap>
    <!-- Where tests keep their data: a RAM disk when there is one (profile test-ramdisk). -->
    <test.tmpdir>${java.io.tmpdir}</test.tmpdir>
  </properties>

