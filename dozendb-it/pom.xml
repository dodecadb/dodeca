<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.dozendb</groupId>
    <artifactId>dozendb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>dozendb-it</artifactId>
  <name>DozenDB integration tests</name>
  <description>Multi-node, fault, crash and benchmark tests against the plugin jar in Neo4j's official Community image. Run with -Pit.</description>

  <properties>
    <!-- Its promtool checks the metrics the plugin reports. -->
    <prometheus.image>prom/prometheus:v3.5.0</prometheus.image>
    <!-- Tests only: no jar to install (see maven-jar-plugin below). -->
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <!-- Only for build order: the tests install the plugin jar into a Docker image. -->
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>dozendb-plugin</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test utilities, such as ports for test servers. -->
    <dependency>
      <groupId>org.dozendb</groupId>
      <artifactId>consensus-api</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Versioned here rather than managed by the parent: managing it would also replace the driver
      that Neo4j itself depends on wherever Neo4j runs in a test JVM.
    -->
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
      <version>${neo4j-java-driver.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility-kotlin</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestCertificates in the consensus-api test-jar uses it. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Tests only: there is nothing to package. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <dozendb.plugin.jar>${project.basedir}/../dozendb-plugin/target/dozendb-${project.version}.jar</dozendb.plugin.jar>
                <neo4j.image>${neo4j.image}</neo4j.image>
                <prometheus.image>${prometheus.image}</prometheus.image>
                <it.logs>${project.build.directory}/it-logs</it.logs>
              </systemPropertyVariables>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.dozendb:dozendb-plugin</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <properties>
                <configurationParameters>
                  junit.platform.discovery.issue.severity.critical=WARNING
                </configurationParameters>
              </properties>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
